{
  "name": "ladestack-build",
  "private": true,
  "description": "LadeStack Build monorepo: Astro website (/) and Next.js builder (/app).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/builder",
    "start": "npm run start --workspace=apps/builder",
    "dev:website": "npm run dev --workspace=apps/website",
    "dev:builder": "npm run dev --workspace=apps/builder",
    "build": "npm run build --workspace=apps/builder",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "fake-indexeddb": "6.2.6",
    "globals": "16.4.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "recharts": "^3.11.0"
  }
}